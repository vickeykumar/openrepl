# OpenREPL server settings. gotty reads an env file when it starts: ~/.env by
# default, or the file named by --env-file. Copy this template there and fill it
# in; keep it out of git and `chmod 600` it.
#
#   standalone:  cp .env.example ~/.env;  gotty -w ...
#                gotty -w --env-file /path/to/this-file ...
#   dev container (where ~ is lost on restart; the repo is mounted):
#                ../bin/gotty -w --env-file /opt/openrepl/.env
#   Docker:      docker run --env-file .env ...     (Docker reads it: no quotes)
#   systemd:     EnvironmentFile=/etc/openrepl/openrepl.env   (root-owned, chmod 600)
#
# Only OPENREPL_* and GOTTY_* names are used; GOTTY_* can set any gotty flag, such
# as GOTTY_PORT. A variable that is already set in the environment wins over this
# file. gotty reads the file once, when it starts. The start-up log line
# `config:` shows what was picked up. The programs users run in the REPLs do not
# receive these variables.
#
# The environment wins over the git-config style file (/opt/gotty/.gitconfig,
# ~/.gitconfig, /etc/.gitconfig). Servers that still use the file keep
# working, and a variable left empty here counts as not set.

# dev or production (the default). In dev the start-up log shows the values of
# the settings below, which makes a wrong one easy to find. In production it
# only says which are set, never their values. Never use dev on a public server.
OPENREPL_ENV=dev

# Admin accounts, comma-separated. Admins see the feedback data, edit the blog
# and are not rate limited. If this is empty (and the file has no user.email)
# nobody is an admin.
OPENREPL_ADMIN_EMAILS=you@example.com

# The OpenAI key for Genie and the practice question generator, as it is (the
# git-config file holds it base64-encoded, this variable does not).
OPENREPL_OPENAI_API_KEY=

# The origin the chat proxy accepts, such as openrepl.example.com.
OPENREPL_HOST=localhost

# The Firebase project the page signs in with. Leave it out to use the built-in
# (production) project. To test sign-in with a development project of your own,
# give its web app config (Firebase console > Project settings > Your apps) in
# any of these forms. apiKey, authDomain and projectId are required:
#
#  - JSON on one line (the single quotes are for gotty's own reading; leave them
#    out for `docker run --env-file`):
# OPENREPL_FIREBASE_CONFIG='{"apiKey":"AIza...","authDomain":"my-dev.firebaseapp.com","projectId":"my-dev","databaseURL":"https://my-dev-default-rtdb.firebaseio.com","appId":"1:123456789:web:abc123"}'
#
#  - the snippet the console shows, on one line, in quotes:
# OPENREPL_FIREBASE_CONFIG='const firebaseConfig = { apiKey: "AIza...", authDomain: "my-dev.firebaseapp.com", projectId: "my-dev" };'
#
#  - base64 of either, which has no quotes. This is also the form of the
#    server's built-in config. Make it with:  base64 < firebase-dev.txt | tr -d '\n'
# OPENREPL_FIREBASE_CONFIG=eyJhcGlLZXkiOiJBSXphLi4uIiwiYXV0aERvbWFpbiI6Ii4uLiIsInByb2plY3RJZCI6Ii4uLiJ9
#
# A wrong value stops the server at start-up and says which field is wrong.
# The admin account in OPENREPL_ADMIN_EMAILS has to exist in that project.

# Distributed mode keeps its secret in the environment as well:
# GOTTY_WORKER_TOKEN=
