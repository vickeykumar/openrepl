{
  "compilerOptions": {
      "strictNullChecks": true,
      "noUnusedLocals" : true,
      "noImplicitThis": true,
      "alwaysStrict": true,
      "outDir": "./dist/",
      "declaration": true,
      "sourceMap": true,
      "target": "es2017",
      "lib": ["dom", "es2017"],
      "module": "esnext",
      "moduleResolution": "node",
      "skipLibCheck": true,
      "typeRoots": [
        "node_modules/@types"
      ],
      "types": [],
      "baseUrl": ".",
      "paths": {
          "*": ["./typings/*"]
      }
  },
  "include": [
      "src/**/*.ts"
  ]
}
